# Michi Assistant - Configuration
PROJECT_NAME="Michi Assistant"
ENVIRONMENT=development

# Database (Default: sqlite)
ASSISTANT_DATABASE_URL=sqlite+aiosqlite:///./assistant.db

# Security (Must match Main API)
SECRET_KEY=secret
ALGORITHM=HS256

# LLM Providers
# To use a real provider, fill the key. Otherwise, Mock provider will be used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Michi Main API
MICHI_API_URL=http://localhost:8000/graphql
